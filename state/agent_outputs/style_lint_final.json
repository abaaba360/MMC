    {
      "para_index": 6,
      "text": "\u5173\u952e\u8bcd\uff1a \u5149\u4f0f\u5fae\u7f51\uff1b\u50a8\u80fd\u8c03\u5ea6\uff1b\u4e24\u9636\u6bb5\u968f\u673a\u89c4\u5212\uff1b\u6a21\u578b\u9884\u6d4b\u63a7\u5236\uff1b\u56e0\u679c\u9884\u6d4b\uff1b\u6df7\u5408\u6574\u6570\u7ebf\u6027\u89c4\u5212",
      "style": "Normal"
    },
    {
      "para_index": 14,
      "text": "\u95ee\u9898\u4e00\uff1a\u5728\u67d0\u65e5144\u4e2a\u65f6\u6bb5\u7684\u7535\u4ef7\u3001\u5c45\u6c11\u8d1f\u8377\u548c\u5149\u4f0f\u51fa\u529b\u5747\u5df2\u77e5\u7684\u6761\u4ef6\u4e0b\uff0c\u786e\u5b9a\u5916\u7f51\u8d2d\u7535\u53ca\u50a8\u80fd\u5145\u653e\u7535\u8ba1\u5212\uff0c\u4f7f\u5f53\u65e5\u8d2d\u7535\u8d39\u7528\u6700\u5c0f\uff0c\u5e76\u7ed9\u51fa\u7ed3\u679c\u89e3\u91ca\u4e0e\u53ef\u884c\u6027\u68c0\u9a8c\u3002",
      "style": "Normal"
    },
    {
      "para_index": 17,
      "text": "\u95ee\u9898\u56db\uff1a\u5f53\u5916\u7f51\u7535\u4ef7\u6539\u4e3a\u4e8b\u524d\u672a\u77e5\u7684\u5b9e\u65f6\u4ef7\u683c\u65f6\uff0c\u5206\u522b\u6309\u7167\u95ee\u9898\u4e8c\u548c\u95ee\u9898\u4e09\u7684\u4fe1\u606f\u66f4\u65b0\u65b9\u5f0f\u5236\u5b9a\u53ef\u6267\u884c\u7b56\u7565\uff0c\u8ba1\u7b97\u5168\u5e74\u8d39\u7528\uff0c\u5e76\u901a\u8fc7\u4e0d\u540c\u4fe1\u606f\u57fa\u51c6\u8bc4\u4ef7\u4ef7\u683c\u9884\u6d4b\u4e0e\u6eda\u52a8\u8c03\u6574\u7684\u4f5c\u7528\u3002",
